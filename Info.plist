<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>BTNEdit</string>
    <key>CFBundleDisplayName</key>
    <string>BTNEdit</string>
    <key>CFBundleIdentifier</key>
    <string>com.btnedit.app</string>
    <key>CFBundleVersion</key>
    <string>0.1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>BTNEdit</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>BTNEdit</string>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Text</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.text</string>
            </array>
        </dict>
        <!--
          Zweiter Eintrag zusaetzlich zu "public.text" oben: "public.text"
          deckt nur Dateien ab, deren UTI im System (oder von einer anderen
          installierten App) bereits als textkonform DEKLARIERT ist. Fuer
          Dateien mit unbekannter/undeklarierter Endung weist macOS
          stattdessen eine generische "dyn.*"-UTI zu, die NICHT zu
          public.text konform ist, selbst wenn der Inhalt eindeutig Text
          ist - BTNEdit wuerde dann trotz "bietet sich fuer alle
          textbasierten Dateiformate an" nicht in "Oeffnen mit" auftauchen.
          CFBundleTypeExtensions umgeht diese UTI-Kette komplett und matcht
          direkt auf die Dateiendung, deckt also zusaetzlich sowohl
          System-unbekannte Endungen als auch BTNEdit-eigene Formate ab, fuer
          die es (anders als z.B. public.json) keine vom System deklarierte
          UTI gibt (allen voran die eigene Hervorhebung aus highlight.c:
          .stl, .dxf, .ini, .config, .svg). Bewusst NICHT "public.data"
          oder "*" - das wuerde die App faelschlich auch fuer Binaerdateien
          (Bilder, Archive, ausfuehrbare Dateien) anbieten, obwohl main.c's
          looks_binary()-Warnung ausdruecklich zeigt, dass sie dafuer nicht
          gedacht ist.
        -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>Text</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>txt</string>
                <string>text</string>
                <string>log</string>
                <string>md</string>
                <string>markdown</string>
                <string>rst</string>
                <string>asc</string>
